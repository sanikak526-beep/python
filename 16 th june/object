Program 3: Multiple Objects
class Student:

    def get_data(self, name, roll):
        self.name = name
        self.roll = roll

    def display(self):
        print("Name:", self.name)
        print("Roll No:", self.roll)

# Create Objects
s1 = Student()
s2 = Student()

# Store Data
s1.get_data("Priyanka", 101)
s2.get_data("Rahul", 102)

# Display Data
s1.display()
print()

s2.display()
